# Configuração central do DEMANDex.
# Copie este arquivo para .env e ajuste apenas URLs públicas/seguras.

# Base da API REST do GitHub utilizada para ler os YAMLs dos Issue Forms.
DEMANDEX_GITHUB_API_BASE=https://api.github.com

# Opcional: endpoint corporativo autenticado para repositórios privados.
# O proxy deve aceitar owner, repository e path como query params e retornar
# o mesmo formato do endpoint GitHub Contents ({ content: base64 }).
DEMANDEX_GITHUB_PROXY_URL=

# Repositórios consultados em “Minhas Demandas”. Não inclua segredos aqui.
DEMANDEX_GITHUB_REPOSITORIES=ti-hu-org/ti-demandas,ti-hu-org/ti-qualidade
